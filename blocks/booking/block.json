{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jat-calendar-sync/booking",
	"version": "1.3.0",
	"title": "Appointment Booking",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Let visitors pick an open time from your calendar (Google, Outlook, iCloud, CalDAV) and book it.",
	"keywords": [
		"booking",
		"appointment",
		"calendar",
		"schedule"
	],
	"textdomain": "jat-calendar-sync",
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"accent": {
			"type": "string",
			"default": ""
		},
		"surface": {
			"type": "string",
			"default": ""
		},
		"buttons": {
			"type": "string",
			"default": ""
		},
		"radius": {
			"type": "string",
			"default": ""
		},
		"density": {
			"type": "string",
			"default": ""
		},
		"headings": {
			"type": "string",
			"default": ""
		},
		"type": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"multiple": true,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true,
			"link": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "jatcs-booking"
}
